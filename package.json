{
  "name": "family-court",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/court/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:live": "node --env-file-if-exists=.env --import tsx scripts/eval-live.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@typesafe-ai/sdk": "^0.7.0",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false
  }
}
