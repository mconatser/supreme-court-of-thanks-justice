# ---- Process ----
# Which app(s) this process runs: all | court | lawyer
MODE=all
PORT=8080
# This Sprite's https URL, used in summons links
PUBLIC_BASE_URL=

# ---- Gateway ----
# live = real Sprites gateway (only works inside a Sprite); stub = canned fixtures for local dev
GATEWAY_MODE=live
# Optional: set only if auto-discovery from /v1/gateway/list picks the wrong connector.
# Use the full gateway_base_url shown by scripts/smoke.sh.
TYPESAFE_BASE=
OLLAMA_BASE=
BOX_BASE=
AGENTMAIL_BASE=
# ElevenLabs text to speech goes through a Custom API connector for https://api.elevenlabs.io
# (the official ElevenLabs connector doesn't forward TTS). Put its gateway_base_url here.
ELEVENLABS_BASE=

# ---- Models ----
# Pin to the exact version reported by the API (e.g. jev-1.14.0) once thresholds are tuned
JEV_MODEL=jev-latest
# A tool-calling cloud model from ollama.com/search?c=cloud
OLLAMA_MODEL=

# ---- Court ----
COURT_URL=http://localhost:8080
# Generate the next two with: openssl rand -hex 32
COURT_TOKEN=
SESSION_SECRET=
COURT_PASSCODE=
PARENT_PASSCODE=
LAWYER_PASSCODE=

# ---- Lawyer ----
# The lawyer's client: their court alias exactly as in people.json (e.g. Max's alias)
LAWYER_CLIENT=
# On a courthouse-only Sprite (MODE=court): where /lawyer redirects (the lawyer's own Sprite)
LAWYER_URL=

# ---- Connector resource IDs ----
BOX_FAMILY_CODE_FILE_ID=
BOX_RECORDS_FOLDER_ID=
AGENTMAIL_INBOX_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# ---- Behavior ----
SUMMONS_TIMEOUT_MIN=15
# true ONLY on the fc-court production Sprite
MISTRIAL_ENABLED=false

# ---- Daily budgets (the court goes into recess when one is used up) ----
JEV_DAILY=300
OLLAMA_DAILY=150
TTS_CHARS_DAILY=3000
EMAIL_DAILY=40
